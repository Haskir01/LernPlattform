<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:dtos="clr-namespace:LernPlattform.Shared.Dtos;assembly=LernPlattform.Shared"
             x:Class="LernPlattform.App.Views.BereichePage"
             x:Name="Seite"
             BackgroundColor="{StaticResource SeiteHell}"
             Title="Prüfungsbereiche">

    <Grid RowDefinitions="Auto,Auto,*"
          Padding="{StaticResource SeitenRand}"
          RowSpacing="{StaticResource AbstandTitelListe}">

        <!-- Seitentitel -->
        <VerticalStackLayout Grid.Row="0" Spacing="2">
            <Label Text="Prüfungsbereiche"
                   FontSize="{StaticResource GroesseSeitentitel}"
                   FontAttributes="Bold"
                   TextColor="{StaticResource TextPrimaerHell}" />
            <Label Text="Fachinformatiker Baden-Württemberg"
                   FontSize="{StaticResource GroesseKontext}"
                   TextColor="{StaticResource TextSekundaerHell}" />
        </VerticalStackLayout>

        <!-- Zustände -->
        <ActivityIndicator Grid.Row="1"
                           IsRunning="{Binding IstAmLaden}"
                           IsVisible="{Binding IstAmLaden}"
                           Color="{StaticResource TextSekundaerHell}" />

        <Label Grid.Row="1"
               Text="{Binding FehlerText}"
               TextColor="#B3261E"
               FontSize="{StaticResource GroesseUntertitel}"
               HorizontalTextAlignment="Center" />

        <!-- Liste -->
        <CollectionView Grid.Row="2" ItemsSource="{Binding Bereiche}">

            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical"
                                   ItemSpacing="{StaticResource AbstandEintraege}" />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="dtos:BereichDto">

                    <Border BackgroundColor="{StaticResource KarteHell}"
                            Stroke="{StaticResource RahmenHell}"
                            StrokeThickness="1"
                            Padding="{StaticResource InnenabstandEintrag}"
                            MinimumHeightRequest="{StaticResource MindesthoeheEintrag}">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="{StaticResource RadiusEintrag}" />
                        </Border.StrokeShape>

                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Source={x:Reference Seite},
                                                  Path=BindingContext.KachelGetipptCommand}"
                                CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>

                        <Grid ColumnDefinitions="58,*,Auto" ColumnSpacing="12">

                            <!-- Kürzel-Chip: blasse Fläche -->
                            <Border Grid.Column="0"
                                    BackgroundColor="{Binding Farbe}"
                                    Opacity="0.12"
                                    HeightRequest="30"
                                    StrokeThickness="0"
                                    VerticalOptions="Center">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="{StaticResource RadiusChip}" />
                                </Border.StrokeShape>
                            </Border>

                            <!-- Kürzel-Chip: Text darüber -->
                            <Label Grid.Column="0"
                                   Text="{Binding Kuerzel}"
                                   TextColor="{Binding Farbe}"
                                   FontSize="{StaticResource GroesseChip}"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />

                            <!-- Titel und Beschreibung -->
                            <VerticalStackLayout Grid.Column="1"
                                                 Spacing="3"
                                                 VerticalOptions="Center">
                                <Label Text="{Binding Titel}"
                                       FontSize="{StaticResource GroesseTitel}"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource TextPrimaerHell}"
                                       MaxLines="2"
                                       LineBreakMode="TailTruncation" />
                                <Label Text="{Binding Beschreibung}"
                                       FontSize="{StaticResource GroesseUntertitel}"
                                       TextColor="{StaticResource TextSekundaerHell}"
                                       MaxLines="2"
                                       LineBreakMode="TailTruncation" />
                            </VerticalStackLayout>

                            <!-- Pfeil -->
                            <Label Grid.Column="2"
                                   Text="›"
                                   FontSize="22"
                                   TextColor="{StaticResource TextSekundaerHell}"
                                   VerticalOptions="Center" />
                        </Grid>
                    </Border>

                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>