<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:dtos="clr-namespace:LernPlattform.Shared.Dtos;assembly=LernPlattform.Shared"
             x:Class="LernPlattform.App.Views.BereichePage"
             x:Name="Seite"
             Title="Prüfungsbereiche">

    <Grid RowDefinitions="Auto,*">

        <!-- Ladeanzeige -->
        <ActivityIndicator Grid.Row="0"
                           IsRunning="{Binding IstAmLaden}"
                           IsVisible="{Binding IstAmLaden}"
                           Margin="0,20" />

        <!-- Fehlermeldung -->
        

        <!-- Die Kacheln -->
        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Bereiche}"
                        Margin="16">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="dtos:BereichDto">

                    <Border BackgroundColor="{Binding Farbe}"
                            StrokeThickness="0"
                            Margin="0,0,0,14"
                            Padding="20">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Source={x:Reference Seite},
                                                  Path=BindingContext.KachelGetipptCommand}"
                                CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="60">
                            <Label Text="{Binding Kuerzel}"
                                   FontSize="30"
                                   FontAttributes="Bold"
                                   TextColor="White" />
                            <Label Text="{Binding Titel}"
                                   FontSize="17"
                                   TextColor="White" />
                            <Label Text="{Binding Beschreibung}"
                                   FontSize="13"
                                   TextColor="White"
                                   Opacity="0.85" />
                        </VerticalStackLayout>
                    </Border>

                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>